# GEMINI_API_KEY: Optional AI Studio environment variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the author website is hosted (injected in Cloud Run / AI Studio).
APP_URL="https://tejasphirake.vercel.app"

# AUTHOR_CMS_PASSPHRASE: Secret passphrase protecting the unlisted /author-studio publishing tools.
# If left unset, /author-studio allows a one-time initial passphrase setup stored hashed on the server.
AUTHOR_CMS_PASSPHRASE=""
